    static class BookRepository {
        private final List<Book> books = new ArrayList<>();

        List<Book> findAll() { return new ArrayList<>(books); }

        Optional<Book> findByIsbn(String isbn) {
            return books.stream().filter(b -> b.getIsbn().equals(isbn)).findFirst();
        }

        List<Book> searchByTitle(String keyword) {
            String lower = keyword.toLowerCase();
            List<Book> result = new ArrayList<>();
            for (Book b : books) if (b.getTitle().toLowerCase().contains(lower)) result.add(b);
            return result;
        }

        List<Book> searchByAuthor(String keyword) {
            String lower = keyword.toLowerCase();
            List<Book> result = new ArrayList<>();
            for (Book b : books) if (b.getAuthor().toLowerCase().contains(lower)) result.add(b);
            return result;
        }

        void save(Book book) { books.add(book); }

        void update(Book updated) {
            for (int i = 0; i < books.size(); i++) {
                if (books.get(i).getIsbn().equals(updated.getIsbn())) {
                    books.set(i, updated);
                    return;
                }
            }
        }

        boolean deleteByIsbn(String isbn) { return books.removeIf(b -> b.getIsbn().equals(isbn)); }
    }

    static class MemberRepository {
        private final List<Member> members = new ArrayList<>();

        List<Member> findAll() { return new ArrayList<>(members); }

        Optional<Member> findById(String memberId) {
            return members.stream().filter(m -> m.getMemberId().equals(memberId)).findFirst();
        }

        Optional<Member> findByEmail(String email) {
            return members.stream().filter(m -> m.getEmail().equalsIgnoreCase(email)).findFirst();
        }

        void save(Member member) { members.add(member); }

        void update(Member updated) {
            for (int i = 0; i < members.size(); i++) {
                if (members.get(i).getMemberId().equals(updated.getMemberId())) {
                    members.set(i, updated);
                    return;
                }
            }
        }

        boolean deleteById(String memberId) { return members.removeIf(m -> m.getMemberId().equals(memberId)); }
    }

    static class TransactionRepository {
        private final List<Transaction> transactions = new ArrayList<>();

        List<Transaction> findAll() { return new ArrayList<>(transactions); }

        Optional<Transaction> findById(String transactionId) {
            return transactions.stream().filter(t -> t.getTransactionId().equals(transactionId)).findFirst();
        }

        List<Transaction> findActiveByMember(String memberId) {
            List<Transaction> result = new ArrayList<>();
            for (Transaction t : transactions) {
                if (t.getMemberId().equals(memberId) && t.getStatus() == Transaction.Status.ISSUED) {
                    result.add(t);
                }
            }
            return result;
        }

        List<Transaction> findOverdue(LocalDate today) {
            List<Transaction> result = new ArrayList<>();
            for (Transaction t : transactions) if (t.isOverdue(today)) result.add(t);
            return result;
        }

        void save(Transaction transaction) { transactions.add(transaction); }

        void update(Transaction updated) {
            for (int i = 0; i < transactions.size(); i++) {
                if (transactions.get(i).getTransactionId().equals(updated.getTransactionId())) {
                    transactions.set(i, updated);
                    return;
                }
            }
        }
    }

