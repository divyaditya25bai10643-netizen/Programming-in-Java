    static class Transaction {
        enum Status { ISSUED, RETURNED }

        private final String transactionId;
        private final String memberId;
        private final String isbn;
        private final LocalDate issueDate;
        private final LocalDate dueDate;
        private LocalDate returnDate;
        private double fineAmount;
        private Status status;

        Transaction(String transactionId, String memberId, String isbn,
                    LocalDate issueDate, LocalDate dueDate) {
            this.transactionId = transactionId;
            this.memberId = memberId;
            this.isbn = isbn;
            this.issueDate = issueDate;
            this.dueDate = dueDate;
            this.returnDate = null;
            this.fineAmount = 0.0;
            this.status = Status.ISSUED;
        }

        String getTransactionId() { return transactionId; }
        String getMemberId() { return memberId; }
        String getIsbn() { return isbn; }
        LocalDate getDueDate() { return dueDate; }
        void setReturnDate(LocalDate returnDate) { this.returnDate = returnDate; }
        double getFineAmount() { return fineAmount; }
        void setFineAmount(double fineAmount) { this.fineAmount = fineAmount; }
        Status getStatus() { return status; }
        void setStatus(Status status) { this.status = status; }

        boolean isOverdue(LocalDate today) {
            return status == Status.ISSUED && today.isAfter(dueDate);
        }

        @Override
        public String toString() {
            return String.format("TxnID: %-10s | Member: %-8s | ISBN: %-15s | Issued: %s | Due: %s | Returned: %-10s | Fine: Rs.%.2f | %s",
                    transactionId, memberId, isbn, issueDate, dueDate,
                    returnDate == null ? "-" : returnDate.toString(), fineAmount, status);
        }
    }

