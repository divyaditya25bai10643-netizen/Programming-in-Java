    static final class IdGenerator {
        private IdGenerator() {}

        static <T> String nextId(List<T> existing, Function<T, String> idExtractor,
                                  String prefix, int padding) {
            int max = 0;
            for (T item : existing) {
                String id = idExtractor.apply(item);
                String numericPart = id.replaceFirst("^" + prefix, "");
                try {
                    int num = Integer.parseInt(numericPart);
                    if (num > max) max = num;
                } catch (NumberFormatException ignored) {
                    // Skip malformed IDs rather than letting them break generation.
                }
            }
            int next = max + 1;
            return prefix + String.format("%0" + padding + "d", next);
        }
    }

    static final class InputValidator {
        private static final Pattern EMAIL_PATTERN =
                Pattern.compile("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$");
        private static final Pattern PHONE_PATTERN = Pattern.compile("^[0-9]{10}$");
        private static final Pattern ISBN_PATTERN = Pattern.compile("^[0-9Xx-]{5,20}$");

        private InputValidator() {}

        static void requireNonBlank(String value, String fieldName) throws InvalidInputException {
            if (value == null || value.trim().isEmpty()) {
                throw new InvalidInputException(fieldName + " cannot be empty.");
            }
            if (value.contains("|")) {
                throw new InvalidInputException(fieldName + " cannot contain the '|' character.");
            }
        }

        static void validateEmail(String email) throws InvalidInputException {
            requireNonBlank(email, "Email");
            if (!EMAIL_PATTERN.matcher(email).matches()) {
                throw new InvalidInputException("Email format is invalid: " + email);
            }
        }

        static void validatePhone(String phone) throws InvalidInputException {
            requireNonBlank(phone, "Phone");
            if (!PHONE_PATTERN.matcher(phone).matches()) {
                throw new InvalidInputException("Phone number must be exactly 10 digits.");
            }
        }

        static void validateIsbn(String isbn) throws InvalidInputException {
            requireNonBlank(isbn, "ISBN");
            if (!ISBN_PATTERN.matcher(isbn).matches()) {
                throw new InvalidInputException("ISBN format is invalid: " + isbn);
            }
        }

        static void validatePositiveInt(int value, String fieldName) throws InvalidInputException {
            if (value <= 0) {
                throw new InvalidInputException(fieldName + " must be a positive number.");
            }
        }
    }

