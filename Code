                    String author = scanner.nextLine();
                    System.out.print("Genre: ");
                    String genre = scanner.nextLine();
                    System.out.print("Total copies: ");
                    int copies = readInt();
                    Book b = bookService.addBook(isbn, title, author, genre, copies);
                    System.out.println("Added: " + b);
                }
                case "2" -> {
                    List<Book> books = bookService.listAllBooks();
                    if (books.isEmpty()) System.out.println("No books in catalog yet.");
                    books.forEach(System.out::println);
                }
                case "3" -> {
                    System.out.print("Title keyword: ");
                    String keyword = scanner.nextLine();
                    printBookResults(bookService.searchByTitle(keyword));
                }
                case "4" -> {
                    System.out.print("Author keyword: ");
                    String keyword = scanner.nextLine();
                    printBookResults(bookService.searchByAuthor(keyword));
                }
                case "5" -> {
                    System.out.print("ISBN to update: ");
                    String isbn = scanner.nextLine().trim();
                    System.out.print("New title (blank to keep unchanged): ");
                    String title = scanner.nextLine();
                    System.out.print("New author (blank to keep unchanged): ");
                    String author = scanner.nextLine();
                    System.out.print("New genre (blank to keep unchanged): ");
                    String genre = scanner.nextLine();
                    System.out.print("New total copies (blank to keep unchanged): ");
                    String copiesRaw = scanner.nextLine().trim();
                    Integer copies = copiesRaw.isEmpty() ? null : Integer.parseInt(copiesRaw);
                    Book updated = bookService.updateBook(isbn, title, author, genre, copies);
                    System.out.println("Updated: " + updated);
                }
                case "6" -> {
                    System.out.print("ISBN to delete: ");
                    String isbn = scanner.nextLine().trim();
                    bookService.deleteBook(isbn);
                    System.out.println("Book deleted.");
                }
                case "0" -> { /* back to main menu */ }
                default -> System.out.println("Invalid choice.");
            }
        } catch (InvalidInputException | DuplicateEntryException | BookNotFoundException e) {
            System.out.println("Error: " + e.getMessage());
            LoggerUtil.warning("Book module error: " + e.getMessage());
        } catch (NumberFormatException e) {
            System.out.println("Error: please enter a valid whole number.");
        }
    }

    private static void printBookResults(List<Book> results) {
        if (results.isEmpty()) System.out.println("No matching books found.");
        results.forEach(System.out::println);
    }

    private static void transactionMenu() {
        System.out.println();
        System.out.println("---- Issue / Return / Reports ----");
        System.out.println("1. Issue a book");
        System.out.println("2. Return a book");
        System.out.println("3. View all transactions");
        System.out.println("4. Overdue report");
        System.out.println("5. Active loans for a member");
        System.out.println("6. Total fines collected (analytics)");
        System.out.println("0. Back");
        System.out.print("Enter choice: ");
        String choice = scanner.nextLine().trim();

        try {
            switch (choice) {
                case "1" -> {
                    System.out.print("Member ID: ");
                    String memberId = scanner.nextLine().trim();
                    System.out.print("Book ISBN: ");
                    String isbn = scanner.nextLine().trim();
                    Transaction t = transactionService.issueBook(memberId, isbn);
                    System.out.println("Issued: " + t);
                }
                case "2" -> {
                    System.out.print("Transaction ID: ");
                    String txnId = scanner.nextLine().trim();
                    Transaction t = transactionService.returnBook(txnId);
                    System.out.println("Returned: " + t);
                    if (t.getFineAmount() > 0) {
                        System.out.printf("A fine of Rs.%.2f is due.%n", t.getFineAmount());
                    }
                }
                case "3" -> {
                    List<Transaction> all = transactionService.getAllTransactions();
                    if (all.isEmpty()) System.out.println("No transactions recorded yet.");
                    all.forEach(System.out::println);
                }
                case "4" -> {
                    List<Transaction> overdue = transactionService.getOverdueReport();
                    if (overdue.isEmpty()) {
                        System.out.println("No overdue books. Great!");
                    } else {
                        System.out.println("Overdue transactions:");
                        overdue.forEach(System.out::println);
                    }
                }
                case "5" -> {
                    System.out.print("Member ID: ");
                    String memberId = scanner.nextLine().trim();
                    List<Transaction> active = transactionService.getActiveTransactionsForMember(memberId);
                    if (active.isEmpty()) System.out.println("This member has no active loans.");
                    active.forEach(System.out::println);
                }
                case "6" -> System.out.printf("Total fines collected to date: Rs.%.2f%n",
                        transactionService.getTotalFinesCollected());
                case "0" -> { /* back to main menu */ }
                default -> System.out.println("Invalid choice.");
            }
        } catch (MemberNotFoundException | BookNotFoundException | BookUnavailableException
                 | InvalidInputException e) {
            System.out.println("Error: " + e.getMessage());
            LoggerUtil.warning("Transaction module error: " + e.getMessage());
        }
    }

    private static int readInt() {
        while (true) {
            try {
                return Integer.parseInt(scanner.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.print("Please enter a valid whole number: ");
            }
        }
    }

