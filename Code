    static class BookService {
        private final BookRepository bookRepository;

        BookService(BookRepository bookRepository) { this.bookRepository = bookRepository; }

        Book addBook(String isbn, String title, String author, String genre, int totalCopies)
                throws InvalidInputException, DuplicateEntryException {
            InputValidator.validateIsbn(isbn);
            InputValidator.requireNonBlank(title, "Title");
            InputValidator.requireNonBlank(author, "Author");
            InputValidator.requireNonBlank(genre, "Genre");
            InputValidator.validatePositiveInt(totalCopies, "Total copies");

            if (bookRepository.findByIsbn(isbn).isPresent()) {
                throw new DuplicateEntryException("A book with ISBN '" + isbn + "' already exists.");
            }

            Book book = new Book(isbn, title, author, genre, totalCopies);
            bookRepository.save(book);
            LoggerUtil.info("Added new book: " + isbn + " (" + title + ")");
            return book;
        }

        List<Book> listAllBooks() { return bookRepository.findAll(); }

        Book getBook(String isbn) throws BookNotFoundException {
            return bookRepository.findByIsbn(isbn)
                    .orElseThrow(() -> new BookNotFoundException("No book found with ISBN: " + isbn));
        }

        List<Book> searchByTitle(String keyword) throws InvalidInputException {
            InputValidator.requireNonBlank(keyword, "Search keyword");
            return bookRepository.searchByTitle(keyword);
        }

        List<Book> searchByAuthor(String keyword) throws InvalidInputException {
            InputValidator.requireNonBlank(keyword, "Search keyword");
            return bookRepository.searchByAuthor(keyword);
        }

        Book updateBook(String isbn, String title, String author, String genre, Integer totalCopies)
                throws BookNotFoundException, InvalidInputException {
            Book existing = getBook(isbn);
            if (title != null && !title.isBlank()) existing.setTitle(title);
            if (author != null && !author.isBlank()) existing.setAuthor(author);
            if (genre != null && !genre.isBlank()) existing.setGenre(genre);
            if (totalCopies != null) {
                InputValidator.validatePositiveInt(totalCopies, "Total copies");
                int issuedCount = existing.getTotalCopies() - existing.getAvailableCopies();
                if (totalCopies < issuedCount) {
                    throw new InvalidInputException(
                            "Cannot set total copies below the number currently issued (" + issuedCount + ").");
                }
                existing.setAvailableCopies(totalCopies - issuedCount);
                existing.setTotalCopies(totalCopies);
            }
            bookRepository.update(existing);
            LoggerUtil.info("Updated book: " + isbn);
            return existing;
        }

        void deleteBook(String isbn) throws BookNotFoundException {
            Book book = getBook(isbn);
            if (book.getAvailableCopies() != book.getTotalCopies()) {
                LoggerUtil.warning("Deleting book " + isbn + " while copies are still on loan.");
            }
            bookRepository.deleteByIsbn(isbn);
            LoggerUtil.info("Deleted book: " + isbn);
        }
    }

    static class MemberService {
        private final MemberRepository memberRepository;

        MemberService(MemberRepository memberRepository) { this.memberRepository = memberRepository; }

        Member registerMember(String name, String email, String phone)
                throws InvalidInputException, DuplicateEntryException {
            InputValidator.requireNonBlank(name, "Name");
            InputValidator.validateEmail(email);
            InputValidator.validatePhone(phone);

            if (memberRepository.findByEmail(email).isPresent()) {
                throw new DuplicateEntryException("A member with email '" + email + "' is already registered.");
            }

            String id = IdGenerator.nextId(memberRepository.findAll(), Member::getMemberId, "M", 3);
            Member member = new Member(id, name, email, phone);
            memberRepository.save(member);
            LoggerUtil.info("Registered new member: " + id + " (" + name + ")");
            return member;
        }

        List<Member> listAllMembers() { return memberRepository.findAll(); }

        Member getMember(String memberId) throws MemberNotFoundException {
            return memberRepository.findById(memberId)
                    .orElseThrow(() -> new MemberNotFoundException("No member found with ID: " + memberId));
        }

        Member updateMember(String memberId, String name, String email, String phone)
                throws MemberNotFoundException, InvalidInputException {
            Member existing = getMember(memberId);
            if (name != null && !name.isBlank()) existing.setName(name);
            if (email != null && !email.isBlank()) {
                InputValidator.validateEmail(email);
                existing.setEmail(email);
            }
            if (phone != null && !phone.isBlank()) {
                InputValidator.validatePhone(phone);
                existing.setPhone(phone);
            }
            memberRepository.update(existing);
            LoggerUtil.info("Updated member: " + memberId);
            return existing;
        }

        void deactivateMember(String memberId) throws MemberNotFoundException {
            Member member = getMember(memberId);
            member.setActive(false);
            memberRepository.update(member);
            LoggerUtil.info("Deactivated member: " + memberId);
        }

        void deleteMember(String memberId) throws MemberNotFoundException {
            if (!memberRepository.deleteById(memberId)) {
                throw new MemberNotFoundException("No member found with ID: " + memberId);
            }
            LoggerUtil.info("Deleted member: " + memberId);
        }
    }

    static class TransactionService {
        static final int LOAN_PERIOD_DAYS = 14;
        static final double FINE_PER_DAY = 5.0;
        static final double MAX_FINE = 200.0;
        static final int MAX_BOOKS_PER_MEMBER = 5;

        private final TransactionRepository transactionRepository;
        private final BookRepository bookRepository;
        private final MemberRepository memberRepository;

        TransactionService(TransactionRepository transactionRepository,
                            BookRepository bookRepository,
                            MemberRepository memberRepository) {
            this.transactionRepository = transactionRepository;
            this.bookRepository = bookRepository;
            this.memberRepository = memberRepository;
        }

        Transaction issueBook(String memberId, String isbn)
                throws MemberNotFoundException, BookNotFoundException, BookUnavailableException, InvalidInputException {

            Member member = memberRepository.findById(memberId)
                    .orElseThrow(() -> new MemberNotFoundException("No member found with ID: " + memberId));
            if (!member.isActive()) {
                throw new InvalidInputException("Member " + memberId + " is inactive and cannot borrow books.");
            }

            Book book = bookRepository.findByIsbn(isbn)
                    .orElseThrow(() -> new BookNotFoundException("No book found with ISBN: " + isbn));
            if (!book.isAvailable()) {
                throw new BookUnavailableException("No available copies of '" + book.getTitle() + "' right now.");
            }

            int currentlyHeld = transactionRepository.findActiveByMember(memberId).size();
            if (currentlyHeld >= MAX_BOOKS_PER_MEMBER) {
                throw new InvalidInputException(
                        "Member " + memberId + " already holds the maximum of " + MAX_BOOKS_PER_MEMBER + " books.");
            }

            LocalDate today = LocalDate.now();
            LocalDate dueDate = today.plusDays(LOAN_PERIOD_DAYS);
            String txnId = IdGenerator.nextId(transactionRepository.findAll(), Transaction::getTransactionId, "T", 5);

            Transaction transaction = new Transaction(txnId, memberId, isbn, today, dueDate);
            transactionRepository.save(transaction);

            book.setAvailableCopies(book.getAvailableCopies() - 1);
            bookRepository.update(book);

            LoggerUtil.info("Issued book " + isbn + " to member " + memberId + " (txn " + txnId + ")");
            return transaction;
        }

        Transaction returnBook(String transactionId)
                throws InvalidInputException, BookNotFoundException {

            Transaction transaction = transactionRepository.findById(transactionId)
                    .orElseThrow(() -> new InvalidInputException("No transaction found with ID: " + transactionId));

            if (transaction.getStatus() == Transaction.Status.RETURNED) {
                throw new InvalidInputException("Transaction " + transactionId + " was already returned.");
            }

            LocalDate today = LocalDate.now();
            double fine = calculateFine(transaction.getDueDate(), today);

            transaction.setReturnDate(today);
            transaction.setFineAmount(fine);
            transaction.setStatus(Transaction.Status.RETURNED);
            transactionRepository.update(transaction);

            Book book = bookRepository.findByIsbn(transaction.getIsbn())
                    .orElseThrow(() -> new BookNotFoundException("Book referenced by transaction not found."));
            book.setAvailableCopies(Math.min(book.getTotalCopies(), book.getAvailableCopies() + 1));
            bookRepository.update(book);

            LoggerUtil.info("Returned transaction " + transactionId + " with fine Rs." + fine);
            return transaction;
        }

        /** Pure function so it stays easy to reason about / unit test. */
        static double calculateFine(LocalDate dueDate, LocalDate returnDate) {
            if (!returnDate.isAfter(dueDate)) return 0.0;
            long daysLate = ChronoUnit.DAYS.between(dueDate, returnDate);
            double fine = daysLate * FINE_PER_DAY;
            return Math.min(fine, MAX_FINE);
        }

        List<Transaction> getAllTransactions() { return transactionRepository.findAll(); }

        List<Transaction> getOverdueReport() { return transactionRepository.findOverdue(LocalDate.now()); }

        List<Transaction> getActiveTransactionsForMember(String memberId) {
            return transactionRepository.findActiveByMember(memberId);
        }

        double getTotalFinesCollected() {
            double total = 0.0;
            for (Transaction t : transactionRepository.findAll()) {
                if (t.getStatus() == Transaction.Status.RETURNED) total += t.getFineAmount();
            }
            return total;
        }
    }

    // ==================================================================
    // CLI (menu-driven, same flow as the original Main class)
    // ==================================================================

    private static final Scanner scanner = new Scanner(System.in);

    private static MemberService memberService;
    private static BookService bookService;
    private static TransactionService transactionService;

    public static void main(String[] args) {
        LoggerUtil.info("Application starting.");

        BookRepository bookRepository = new BookRepository();
        MemberRepository memberRepository = new MemberRepository();
        TransactionRepository transactionRepository = new TransactionRepository();

        memberService = new MemberService(memberRepository);
        bookService = new BookService(bookRepository);
        transactionService = new TransactionService(transactionRepository, bookRepository, memberRepository);

        seedSampleData();

        boolean running = true;
        while (running) {
            printMainMenu();
            if (!scanner.hasNextLine()) break; // no more stdin (e.g. non-interactive online run)
            String choice = scanner.nextLine().trim();
            try {
                switch (choice) {
                    case "1" -> memberMenu();
                    case "2" -> bookMenu();
                    case "3" -> transactionMenu();
                    case "0" -> {
                        running = false;
                        System.out.println("Goodbye!");
                        LoggerUtil.info("Application exiting normally.");
                    }
                    default -> System.out.println("Invalid choice. Please try again.");
                }
            } catch (Exception e) {
                System.out.println("Error: " + e.getMessage());
                LoggerUtil.severe("Unhandled error in menu loop: " + e.getMessage());
            }
        }
    }

